# Add to /etc/audit/rules.d/ssh-logger.rules on x86_64 Linux.
# loginuid includes root SSH sessions and may include local login sessions.
-a always,exit -F arch=b64 -S execve,execveat -F auid!=4294967295 -k sshlogger_exec
-a always,exit -F arch=b32 -S execve,execveat -F auid!=4294967295 -k sshlogger_exec
